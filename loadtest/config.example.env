# ── Sentela load generator config ────────────────────────────────────────────
# Copy to config.env and edit:  cp config.example.env config.env
# Load it before running:       set -a; . ./config.env; set +a; node load-test.mjs
# (the systemd unit reads config.env via EnvironmentFile automatically)

# ── Targets ──────────────────────────────────────────────────────────────────
# One or more base URLs. Each target gets its OWN independent Mbit/s budget and
# its own metrics — so listing 3 CDNs offers the SAME load to each, which is the
# fair way to compare them. Mind your test server's uplink: peak = MAX_MBPS × N.
TARGETS=https://top661743905.mwscdn.ru
# Compare several at once (uncomment, ensure uplink ≥ MAX_MBPS × count):
# TARGETS=https://top661743905.mwscdn.ru,https://cdn2.example.ru,https://sentela.org

# Safety allowlist — refuse to run against anything not matching. STRONGLY
# recommended (a load generator pointed at the wrong host is a DoS). Subdomains
# of a listed host are allowed.
ALLOWED_HOSTS=mwscdn.ru,sentela.org

# ── Bandwidth band (per target) ──────────────────────────────────────────────
MIN_MBPS=50
MAX_MBPS=150
JITTER=0.08          # ±8% random wobble so it isn't robotic
WARMUP_SEC=60        # ramp load in over the first minute

# ── Time of day ──────────────────────────────────────────────────────────────
# Leave TZ_OFFSET_HOURS unset to use the test server's local time. Set it to your
# audience's timezone (Moscow = 3) so "evening" peaks when YOUR users are active.
TZ_OFFSET_HOURS=3
# Optional custom curve: 24 comma-separated 0..1 multipliers (one per hour).
# Default is mornings-low / midday-mid / evening-peak. Preview with:
#   MODE=schedule node load-test.mjs
# DIURNAL=0.18,0.12,0.06,0.04,0.05,0.10,0.16,0.22,0.28,0.34,0.42,0.50,0.55,0.58,0.56,0.54,0.58,0.66,0.78,0.90,1.00,0.92,0.70,0.40

# ── Accounts (needed for dashboard + WebSocket traffic) ──────────────────────
# Create a few DEDICATED load-test users in the app first, then list them here.
# "email:password,email2:password2". Cookies are reused (a real browser logs in
# once) so origin bcrypt cost stays tiny.
TEST_ACCOUNTS=
AUTH_FRACTION=0.2          # 20% of visits are logged-in users, 80% anonymous
LOGIN_REFRESH_SEC=3600     # re-login at most once an hour per account

# Real ids make authed traffic faithful (optional). Comma-separated.
MONITOR_IDS=               # e.g. 12,15,18  → exercises /dashboard/monitors/<id>
STATUS_PROJECTS=           # public /status/<slug> pages, e.g. my-status

# ── WebSocket pool (per target) ──────────────────────────────────────────────
WS_TARGET=40               # steady concurrent /realtime connections (0 = off)
WS_HOLD_SEC=300            # hold each connection ~5 min, then recycle

# ── Optional extra coverage (off by default) ─────────────────────────────────
# Cheap POST passthrough test: logins with random non-existent emails → fast 401,
# NO bcrypt on origin (the user lookup misses before any password hashing). This
# measures how the CDN handles POST under load, NOT origin auth cost. It DOES
# still run a DB lookup per request, so keep it modest and only raise it if your
# origin/CDN has request rate limiting. Leave at 0 unless you specifically want
# to test POST passthrough.
POST_PROBE_RPS=0
# Heartbeat pings WRITE to your DB. Only enable with REAL tokens of test monitors.
HEARTBEAT_TOKENS=
HEARTBEAT_RPS=0

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_CONCURRENCY=400        # max simultaneous in-flight visits per target
MAX_SOCKETS=256            # keep-alive socket pool per target
MAX_ASSETS_PER_VISIT=64    # how many /_next/static assets a visit pulls (browser-like)
REQUEST_TIMEOUT_MS=15000
INSECURE_TLS=false         # true only to accept a self-signed origin cert

# ── Output ───────────────────────────────────────────────────────────────────
METRICS_INTERVAL_SEC=10
LOG_DIR=./logs
DURATION_SEC=0             # 0 = run until stopped (Ctrl-C / touch ./STOP / systemctl stop)
STOP_FILE=./STOP
VERBOSE=false
