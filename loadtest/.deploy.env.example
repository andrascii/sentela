# ── Подключение к серверу-генератору нагрузки (НЕ к origin!) ──────────────────
# Копировать:  cp .deploy.env.example .deploy.env && nano .deploy.env
# Затем:       ./deploy.sh

SERVER_HOST=loadgen.example.com   # IP или домен сервера, с которого польётся нагрузка
SERVER_USER=root                  # пользователь SSH (нужен root/sudo для установки Node + systemd)
SSH_PORT=22
# SSH_KEY=~/.ssh/id_ed25519       # путь к приватному ключу (если не дефолтный)

REMOTE_DIR=/opt/sentela-loadtest  # куда положить скрипт на сервере
SERVICE_USER=loadtest             # системный пользователь, под которым крутится сервис
NODE_MAJOR=20                     # какую мажорную версию Node ставить, если её нет

# AUTOSTART=no                    # yes — запустить тест сразу после деплоя (нужен заполненный config.env)
