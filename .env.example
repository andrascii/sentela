# Database
DATABASE_URL=postgres://edgepulse:edgepulse_password@postgres:5432/edgepulse

# Auth — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-string

# Telegram bot token from @BotFather (optional — alerts are skipped if unset)
TELEGRAM_BOT_TOKEN=

# Reverse proxy for the Bot API when api.telegram.org is blocked (e.g. RU egress).
# Point at a proxy that forwards to https://api.telegram.org (Cloudflare Worker /
# nginx). Leave empty to use api.telegram.org directly.
TELEGRAM_API_BASE=

# Worker tick: how often (seconds) the worker scans for due monitors
WORKER_TICK_SECONDS=15

# Realtime WebSocket service (live dashboard updates). Port is published to the
# host; nginx proxies /realtime to it. Must match the docker-compose port mapping.
WS_PORT=3001

# SSRF guard: when "true", monitors may target private/loopback addresses.
# Link-local / cloud-metadata (169.254.0.0/16) is ALWAYS blocked. Leave unset in
# production; the Docker demo sets it to "true" so it can monitor its own services.
ALLOW_PRIVATE_TARGETS=false

# Public base URL (used for links in alerts / status pages and metadata).
# Production with a domain: https://monitor.example.com
APP_BASE_URL=http://localhost:3000

# --- Production HTTPS ---
# HTTPS обслуживает отдельный слой nginx (docker-compose.nginx.yml) с вашим
# сертификатом — см. DEPLOY.md. Для домена выставьте APP_BASE_URL=https://<домен>.

# Set to "false" ONLY for a quick test deploy over plain http://SERVER_IP:3000
# (otherwise secure cookies block login over HTTP). Leave unset when using HTTPS.
# COOKIE_SECURE=false

# --- Платежи (YooKassa / ЮKassa) ---
# shopId и секретный ключ из ЛК ЮKassa. Без них платные тарифы недоступны к покупке
# (Starter остаётся бесплатным). Есть тестовый магазин для проверки.
# Вебхук настрой в ЮKassa на адрес: <APP_BASE_URL>/api/billing/webhook
# (событие payment.succeeded).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
