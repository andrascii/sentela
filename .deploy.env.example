# Куда деплоить. Скопируй в .deploy.env и заполни своими данными.
# cp .deploy.env.example .deploy.env

# IP или домен сервера
SERVER_HOST=203.0.113.10

# Пользователь SSH (обычно root или с sudo-доступом к docker)
SERVER_USER=root

# Каталог на сервере, куда положить проект
REMOTE_DIR=/opt/sentela

# Порт SSH (по умолчанию 22)
SSH_PORT=22

# Необязательно: путь к приватному SSH-ключу (если не используешь ssh-agent)
# SSH_KEY=~/.ssh/id_ed25519

# Где собирать образ:
#   local  (по умолчанию) — на этой машине, потом передать готовый образ на сервер.
#                           Надёжно для VPS с малым объёмом RAM (сервер не собирает).
#   remote — собирать на сервере (нужно ~1.5 ГБ RAM на сервере).
# BUILD_MODE=local

# Архитектура сервера для BUILD_MODE=local: amd64 (большинство VPS) или arm64
# SERVER_ARCH=amd64
